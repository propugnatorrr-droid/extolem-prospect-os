generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./keelead.db"
}

model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  company     String?
  title       String?
  website     String?
  linkedin    String?
  location    String?
  source      String?
  status      String   @default("new") // new, contacted, qualified, converted, lost
  score       Int      @default(0)
  verified    Boolean  @default(false)
  tags        String?  // JSON array of tags
  notes       String?
  metadata    String?  // JSON object for extra data
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([company])
  @@index([status])
  @@index([campaignId])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("draft") // draft, active, paused, completed
  type        String   @default("email") // email, linkedin, phone, multi
  targetLeads Int      @default(0)
  sentCount   Int      @default(0)
  openRate    Float    @default(0)
  replyRate   Float    @default(0)
  metadata    String?  // JSON object
  leads       Lead[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  title     String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  role           String       // user, assistant, system
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  metadata       String?      // JSON for lead results, etc.
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model VerificationLog {
  id        String   @id @default(cuid())
  email     String
  result    String   // JSON with verification details
  score     Int
  status    String   // valid, invalid, catch-all, disposable, unknown
  createdAt DateTime @default(now())

  @@index([email])
}

model ExportLog {
  id        String   @id @default(cuid())
  format    String   // csv, json, xlsx, vcard, pdf
  count     Int
  filters   String?  // JSON filters applied
  filePath  String?
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON value
}

// --- Extolem Prospect OS: business-centric prospecting model ---

model SearchRun {
  id          String     @id @default(cuid())
  query       String     // raw natural-language request
  categories  String     // JSON array
  location    String
  radiusKm    Float?
  sources     String     // JSON array of source ids used
  status      String     @default("running") // running, completed, failed
  resultCount Int        @default(0)
  error       String?
  businesses  Business[]
  createdAt   DateTime   @default(now())
  completedAt DateTime?
}

model Business {
  id          String    @id @default(cuid())
  name        String
  category    String?
  phone       String?
  website     String?
  street      String?
  suburb      String?
  state       String?
  postcode    String?
  country     String    @default("AU")
  latitude    Float?
  longitude   Float?
  rating      Float?
  reviewCount Int?
  placeId     String?   @unique
  abn         String?
  status      String    @default("new") // new, reviewed, called, contacted, qualified, not_interested, do_not_contact
  notes       String?
  metadata    String?   // JSON blob for anything not modeled yet

  searchRunId String?
  searchRun   SearchRun? @relation(fields: [searchRunId], references: [id])

  sources       BusinessSource[]
  contacts      Contact[]
  opportunities Opportunity[]
  audits        WebsiteAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([website])
  @@index([suburb])
  @@index([postcode])
  @@index([status])
}

model BusinessSource {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source     String   // google_maps_apify, yellowpages_au, openstreetmap, google_search
  sourceId   String?
  sourceUrl  String?
  raw        String?  // JSON snapshot of the original record
  fetchedAt  DateTime @default(now())

  @@index([businessId])
  @@unique([businessId, source, sourceId])
}

model Contact {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String   // phone, mobile, email, facebook, instagram, linkedin, booking_url, contact_form
  value      String
  label      String?
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model WebsiteAudit {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  findings   String   // JSON array of AuditFinding
  score      Int?
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model Opportunity {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  offer      String   // website, ai_chatbot, ai_receptionist, review_automation, seo, erp, etc.
  score      Int
  confidence Float
  reasons    String   // JSON array of strings
  createdAt  DateTime @default(now())

  @@index([businessId])
}
