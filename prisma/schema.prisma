generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model SearchRun {
  id          String   @id @default(cuid())
  query       String
  categories  String
  location    String
  radiusKm    Float?
  sources     String
  filters     String?
  status      String   @default("starting")
  resultCount Int      @default(0)
  error       String?

  sourceRuns SourceRun[]
  businesses SearchRunBusiness[]

  legacyBusinesses Business[] @relation("LegacySearchRun")

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model SourceRun {
  id            String    @id @default(cuid())
  searchRunId   String
  searchRun     SearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)

  source        String
  providerRunId String?   @unique
  datasetId     String?
  status        String    @default("starting")
  imported      Boolean   @default(false)
  importedCount Int       @default(0)
  error         String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  importedAt  DateTime?

  @@index([searchRunId])
  @@index([status])
}

model SearchRunBusiness {
  searchRunId String
  businessId  String

  searchRun SearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)
  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([searchRunId, businessId])
  @@index([businessId])
}

model Business {
  id          String  @id @default(cuid())
  name        String
  category    String?
  phone       String?
  website     String?
  street      String?
  suburb      String?
  state       String?
  postcode    String?
  country     String  @default("AU")
  latitude    Float?
  longitude   Float?
  rating      Float?
  reviewCount Int?
  placeId     String? @unique
  abn         String?
  status      String  @default("new")
  notes       String?
  metadata    String?

  searchRunId String?
  searchRun   SearchRun? @relation("LegacySearchRun", fields: [searchRunId], references: [id])

  searchRuns    SearchRunBusiness[]
  sources       BusinessSource[]
  contacts      Contact[]
  opportunities Opportunity[]
  audits        WebsiteAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([website])
  @@index([suburb])
  @@index([postcode])
  @@index([status])
  @@index([name])
}

model BusinessSource {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  source    String
  sourceId  String?
  sourceUrl String?
  raw       String?
  fetchedAt DateTime @default(now())

  @@index([businessId])
  @@index([source])
  @@unique([businessId, source, sourceId])
}

model Contact {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type       String
  value      String
  label      String?
  sourceUrl  String?
  confidence Float?
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([type])
  @@unique([businessId, type, value])
}

model WebsiteAudit {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  url      String
  findings String
  score    Int?
  createdAt DateTime @default(now())

  @@index([businessId])
}

model Opportunity {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  offer      String
  score      Int
  confidence Float
  reasons    String
  createdAt  DateTime @default(now())

  @@index([businessId])
}
