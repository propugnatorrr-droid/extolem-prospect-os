# Extolem ProspectOS — environment configuration

# Database (Neon Postgres). DATABASE_URL is pooled (pgbouncer), used for
# normal queries. DATABASE_URL_UNPOOLED is direct, used for db push/migrate.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Lead discovery (Apify)
APIFY_TOKEN=""

# ABN Lookup (Australian Business Register) — free self-service GUID from
# https://abr.business.gov.au/Tools/WebServices
ABR_GUID=""

# Google PageSpeed Insights (website audits) — works without a key at low
# volume; add one to raise the rate limit.
PAGESPEED_API_KEY=""

# Natural-language search parsing (OpenRouter)
OPENROUTER_API_KEY=""

# Auth
APP_PASSWORD=""
AUTH_SECRET=""

# Operator profile — personalizes the assistant and powers "near me" defaults
OPERATOR_FIRST_NAME=""
OPERATOR_LAST_NAME=""
OPERATOR_HOME_LOCATION=""
OPERATOR_TIMEZONE="Australia/Sydney"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
